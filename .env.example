# Runtime data source selection for dashboard/API (database only)
EXPOSURE_DATA_SOURCE=database

# Netlas (recommended for free automation)
# Preferred for multi-key: comma/newline list
NETLAS_API_KEYS=
# Optional explicit numbered keys
# NETLAS_API_KEY_1=
# NETLAS_API_KEY_2=
# Backward compatible single-key setting
NETLAS_API_KEY=

# Recommended high-confidence query for OpenClaw UI fingerprints
NETLAS_QUERY=(http.title:"OpenClaw Control") OR (http.body:"openclaw-app") OR (http.body:"__OPENCLAW_CONTROL_UI_BASE_PATH__")
NETLAS_BASE_URL=https://app.netlas.io

# Free plan page cap is 10. Each page ~= 1 API request.
NETLAS_MAX_PAGES=10
NETLAS_START_STEP=20
NETLAS_TIMEOUT_MS=30000
NETLAS_INCLUDE_RAW_PAGES=false

# Fetch tuning (default: balanced)
NETLAS_MIN_NEW_PER_PAGE=3
NETLAS_MAX_LOW_NEW_PAGES=2
NETLAS_DUPLICATE_RATIO_STOP=0.92
NETLAS_FETCH_RETRIES=1
NETLAS_RETRY_BASE_MS=800

# Validation run options
NETLAS_VALIDATION_START=0
NETLAS_VALIDATION_MAX_KEYS=2
NETLAS_VALIDATION_MAX_PAGES=10
NETLAS_DAILY_REQUEST_BUDGET_PER_KEY=50

# Neon
DATABASE_URL=
NETLAS_ENCRYPTION_KEY=
