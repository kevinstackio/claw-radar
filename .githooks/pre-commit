#!/bin/sh

set -e

run_pnpm() {
  if command -v pnpm >/dev/null 2>&1; then
    pnpm "$@"
    return
  fi

  if command -v corepack >/dev/null 2>&1; then
    corepack pnpm "$@"
    return
  fi

  echo "[hook] error: pnpm/corepack not found in PATH."
  exit 1
}

echo "[pre-commit] checking format..."
run_pnpm format:check

echo "[pre-commit] checking lint errors..."
run_pnpm lint
